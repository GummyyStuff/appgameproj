{
  "name": "@tarkov-casino/backend",
  "version": "1.0.0",
  "description": "Backend API for Tarkov Casino",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
  "dev:watch": "bun run --watch --no-clear src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun --bytecode --minify --sourcemap --external node-appwrite --external hono --external zod --external hono-rate-limiter --external @sentry/bun --external @sentry/node",
    "build:dev": "bun build src/index.ts --outdir ./dist --target bun --external node-appwrite --external hono --external zod --external hono-rate-limiter --external @sentry/bun --external @sentry/node",
    "build:standalone": "bun build --compile --minify --sourcemap --bytecode src/index.ts --outfile ../../tarkov-casino-server",
    "start": "bun run dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:fairness": "vitest run src/test-utils/game-fairness.test.ts",
    "test:game-engine": "vitest run src/services/game-engine/",
    "test:api": "vitest run src/routes/",
    "test:currency": "vitest run src/services/currency.test.ts src/integration/currency-api.test.ts",
    "test:ci": "vitest run --coverage",
    "db:setup": "bun run src/database/setup.ts",
    "db:setup-with-seed": "bun run src/database/setup.ts --seed",
    "db:verify": "bun run src/database/setup.ts --verify",
    "db:test-connection": "bun run src/scripts/test-connection.ts",
    "db:populate-items": "bun run src/scripts/populate-global-item-pool.ts",
    "db:cleanup-pools": "bun run src/scripts/cleanup-case-item-pools.ts",
    "db:test-items": "bun run src/scripts/test-global-item-pool.ts",
    "seed:achievements": "bun run src/scripts/seed-achievements.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "decimal.js": "10.6.0",
    "hono": "catalog:default",
    "hono-rate-limiter": "^0.4.2",
    "node-appwrite": "catalog:default",
    "zod": "catalog:default"
  },
  "devDependencies": {
    "@types/bun": "catalog:default",
    "@types/decimal.js": "7.4.3",
    "typescript": "catalog:default"
  }
}
