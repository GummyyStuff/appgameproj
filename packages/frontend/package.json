{
  "name": "@tarkov-casino/frontend",
  "version": "1.0.0",
  "description": "Frontend React app for Tarkov Casino",
  "type": "module",
  "scripts": {
    "dev": "cd ../backend && bun run dev",
    "build": "bun run build.ts",
    "build:dev": "NODE_ENV=development bun run build.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest run src/components src/hooks src/utils",
    "test:components": "vitest run src/components",
    "test:hooks": "vitest run src/hooks",
    "test:auth": "vitest run src/components/auth",
    "test:games": "vitest run src/components/games",
    "test:ui": "vitest run src/components/ui",
    "test:performance": "vitest run src/utils/__tests__/cache.test.ts src/utils/__tests__/lazy-loading.test.tsx",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@tanstack/react-query": "^5.101.2",
    "appwrite": "catalog:default",
    "clsx": "2.1.1",
    "framer-motion": "^13.1.0",
    "lightweight-charts": "5.0.9",
    "lucide-react": "0.545.0",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.3.1",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:default",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "catalog:default",
    "@types/bun": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "^10.4.21",
    "bun-plugin-tailwind": "^0.1.2",
    "happy-dom": "catalog:default",
    "postcss": "^8.5.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.13",
    "terser": "^5.44.0",
    "typescript": "catalog:default"
  }
}
