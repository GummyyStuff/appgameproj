# Development Environment Variables

# Appwrite Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=main_db

# Application Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Game Configuration
STARTING_BALANCE=10000
DAILY_BONUS=1000

# Redis Configuration (optional - app falls back to DB if unavailable)
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging Configuration
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_GAME_LOGGING=true
ENABLE_SECURITY_LOGGING=true

# Performance Configuration
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Monitoring Configuration
HEALTH_CHECK_TIMEOUT=5000
METRICS_ENABLED=true

# Sentry (optional error tracking)
# SENTRY_DSN=your_sentry_dsn

# CSP Configuration (optional)
# Comma-separated list of additional origins to allow in connect-src.
# Appwrite and Sentry origins are auto-detected from their respective env vars.
# CSP_CONNECT_EXTRA=https://example.com,https://api.other-service.com
